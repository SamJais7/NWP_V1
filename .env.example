# Project Pratyay / Satark-Mausam - Example Environment Configuration
# Copy this file to .env and fill in your custom keys:
#   cp .env.example .env

# Geoapify GIS & Geocoding API (Get your free key at https://myprojects.geoapify.com/)
GEOAPIFY_API_KEY=your_geoapify_api_key_here
GEOAPIFY_TILE_STYLE=dark-matter-dark-grey
GEOAPIFY_BASE_URL=https://api.geoapify.com

# IMD (India Meteorological Department) Official API Configuration
IMD_API_BASE_URL=https://mausam.imd.gov.in/api
IMD_API_KEY=your_imd_api_token_here_if_applicable

# Open-Meteo Numerical Weather Prediction Engine (Public - No Key Required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_HISTORICAL_URL=https://historical-forecast-api.open-meteo.com/v1
